// GifSuite on Cloudflare. No secrets in this file: they're set with `wrangler secret put NAME`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gifsuite",
  "main": "worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Don't upload Wrangler usage metrics: on a slow connection that request hangs and the command never exits.
  "send_metrics": false,

  // ── Production ────────────────────────────────────────────────────────────────
  // www.gifsuite.com answers too, but worker.ts redirects it to gifsuite.com (one address for search
  // engines). worker.ts also redirects gifsuite.app; add its two routes here once the GitHub deploy
  // token has access to the gifsuite.app zone (see DEPLOY.md).
  "routes": [
    { "pattern": "gifsuite.com", "custom_domain": true },
    { "pattern": "www.gifsuite.com", "custom_domain": true }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://gifsuite.com",
    // Only production is allowed into search engines. Staging, dev and test leave this unset.
    "ALLOW_INDEXING": "1",
    "MAX_SOURCE_MB": "50",
    "MAX_DURATION_S": "60",
    "MAX_UPLOAD_MB": "25",
    "AUTO_HIDE_REPORTS": "5"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "gifsuite", "database_id": "bcc11ed9-6478-49ed-80c6-dc6d52fc7980", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gifsuite-media" }],
  "containers": [
    // rollout_step_percentage 100: update every instance at once on deploy. The default (10% first)
    // leaves a small app's container on the old image, so new processor features 404.
    { "class_name": "MediaProcessor", "image": "./processor/Dockerfile", "max_instances": 5, "instance_type": "standard-1", "rollout_step_percentage": 100 }
  ],
  "durable_objects": { "bindings": [{ "name": "PROCESSOR", "class_name": "MediaProcessor" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MediaProcessor"] }],
  // Server-side event analytics (lib/analytics.ts); query with `npm run analytics`.
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "gifsuite_events" }],
  // Every 5 minutes: retry NSFW checks that didn't finish after a grab (worker.ts `scheduled`).
  "triggers": { "crons": ["*/5 * * * *"] },
  "ratelimits": [
    { "name": "GRAB_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "UPLOAD_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],

  "env": {
    // ── Staging: same setup, separate data, on a staging subdomain ─────────────
    "staging": {
      "routes": [{ "pattern": "staging.gifsuite.com", "custom_domain": true }],
      "triggers": { "crons": ["*/5 * * * *"] },
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "gifsuite_events_staging" }],
      "vars": {
        "PUBLIC_BASE_URL": "https://staging.gifsuite.com",
        "MAX_SOURCE_MB": "50",
        "MAX_DURATION_S": "60",
        "MAX_UPLOAD_MB": "25",
        "AUTO_HIDE_REPORTS": "5"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "gifsuite-staging", "database_id": "8bb26c05-abd0-4a74-a022-cfb0560fe946", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gifsuite-media-staging" }],
      "containers": [
        { "class_name": "MediaProcessor", "image": "./processor/Dockerfile", "max_instances": 2, "instance_type": "standard-1", "rollout_step_percentage": 100 }
      ],
      "durable_objects": { "bindings": [{ "name": "PROCESSOR", "class_name": "MediaProcessor" }] },
      "ratelimits": [
        { "name": "GRAB_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
        { "name": "UPLOAD_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } }
      ]
    },

    // ── Dev: `npm run dev` on your Mac. Real X, local processor, local D1/R2, no Docker. ──
    "dev": {
      // Local only: no routes, so `wrangler dev` doesn't pretend requests come from gifsuite.com.
      "routes": [],
      // The local processor lives on 127.0.0.1, so the public-only fetch flag is off here.
      "compatibility_flags": ["nodejs_compat"],
      "vars": {
        "PROCESSOR_URL": "http://127.0.0.1:3297",
        "MAX_SOURCE_MB": "50",
        "MAX_DURATION_S": "60",
        "MAX_UPLOAD_MB": "25",
        "AUTO_HIDE_REPORTS": "5"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "gifsuite-dev", "database_id": "dev", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gifsuite-media-dev" }],
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "gifsuite_events_dev" }]
    },

    // ── Test: local only (`npm run check`). Fake X, local processor, no Docker. ──
    "test": {
      // Local only: no routes, so `wrangler dev` doesn't pretend requests come from gifsuite.com.
      "routes": [],
      // Tests fetch from the fake X on 127.0.0.1, so the public-only fetch flag is off here.
      "compatibility_flags": ["nodejs_compat"],
      "vars": {
        "X_SYNDICATION_URL": "http://127.0.0.1:3298/tweet-result",
        "X_MEDIA_HOSTS": "127.0.0.1:3298",
        "PROCESSOR_URL": "http://127.0.0.1:3296",
        "ADMIN_TOKEN": "test-admin-token-not-a-real-secret",
        "TRUST_FORWARDED_FOR": "1",
        // Tests make X fail on purpose many times; don't let the circuit breaker pause it for later tests.
        "X_BREAKER_FAILURES": "1000",
        // A dummy Web Analytics site token, so tests check the beacon is allowed by the CSP.
        "CF_WEB_ANALYTICS_TOKEN": "0123456789abcdef0123456789abcdef",
        "AUTO_HIDE_REPORTS": "3",
        "MAX_SOURCE_MB": "50",
        "MAX_DURATION_S": "60",
        "MAX_UPLOAD_MB": "3"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "gifsuite-test", "database_id": "test", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gifsuite-media-test" }],
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "gifsuite_events_test" }]
    }
  }
}
