# Copy to .env.local for `npm run dev`. Never commit .env.local.
# Production values are set with `wrangler secret put NAME`, never in files.

# Absolute site URL used in link previews, e.g. https://gifsuite.example
PUBLIC_BASE_URL=

# Long random string (24+ chars). Enables POST /api/admin/hide. Generate: openssl rand -hex 32
ADMIN_TOKEN=

# Random string used when counting unique visitors without storing IPs. Generate: openssl rand -hex 32
VISITOR_SALT=

# Optional limits and tuning
AUTO_HIDE_REPORTS=5
MAX_SOURCE_MB=50
MAX_DURATION_S=60

# Only for `npm run analytics` on your machine: a Cloudflare API token with "Account Analytics: Read".
CF_ANALYTICS_TOKEN=

# Only for `npm run keywords` on your machine: Keywords Everywhere API key (keyword volumes for blog topics).
KEYWORDS_EVERYWHERE_API_KEY=
