# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/processor/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Wrangler local secrets
.dev.vars*
!.dev.vars.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# GifSuite media + database
/data

# Test runs
/.test-data
/.next-test
/tests/.fixtures
/test-results
/playwright-report
/.next-leakcheck

# Cloudflare build output and local state
/.open-next
/.wrangler
/.deploy-logs

# Compiled from content/blog by scripts/build-content.mjs
/lib/blog/posts.generated.json
