{
  "name": "gifsuite",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "lint": "eslint",
    "test": "vitest run",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "check": "npm run scan:secrets && npm run typecheck && eslint && vitest run && playwright test --project=api",
    "check:all": "npm run scan:secrets && npm run typecheck && eslint && vitest run && playwright test && npm run check:leaks",
    "typecheck": "next typegen >/dev/null && tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check:leaks": "node scripts/check-bundle-leaks.mjs",
    "cf-types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy:staging": "opennextjs-cloudflare build && wrangler d1 migrations apply DB --remote --env staging && wrangler deploy --env staging",
    "deploy:production": "opennextjs-cloudflare build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:status": "sh scripts/deploy-status.sh"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@opennextjs/cloudflare": "^1.20.7",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.9.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  }
}
